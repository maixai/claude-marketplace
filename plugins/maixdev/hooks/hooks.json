{
  "description": "登记开发角色身份，并在测试先行模式下防止开发角色误改测试、数据、快照和相关配置。",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "maixdev:developer|maixdev:test-developer|maixdev:reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" observe",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" hook",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
